---
// Shared shell for /games/<slug>: title bar, close/back, touch guard, and game start/cleanup.
import RosterData from '../components/RosterData.astro';
import { url } from '../lib/url';

interface Props {
  title: string;
  slug: string;
  closeLabel?: string;
}
const { title, slug, closeLabel } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no" />
    <title>{title} | Samuel Butler Room</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href={url('/favicon.ico')} sizes="any" />
    <link rel="icon" type="image/png" href={url('/favicon-32.png')} />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
  </head>
  <body>
    <header class="bar">
      <h1>{title}</h1>
      <a
        class:list={['close', { labelled: closeLabel }]}
        href={url('/')}
        aria-label={closeLabel ?? 'Close game'}
      >
        {closeLabel ?? '\u00d7'}
      </a>
    </header>
    <main id="game-root" data-slug={slug}></main>
    <template id="desktop-only">
      <div class="notice">
        <h2>Desktop only</h2>
        <p>
          This game requires a keyboard, a desk, and a sense of purpose. Please return with all
          three.
        </p>
      </div>
    </template>
    <RosterData full />
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    height: 100%;
    background: #14141e;
    color: #eef1f6;
    font-family: system-ui, sans-serif;
    overflow: hidden;
    overscroll-behavior: none;
  }
  body {
    display: flex;
    flex-direction: column;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.4rem 0.75rem;
    background: var(--primary-dark);
    border-bottom: 3px solid var(--accent);
  }
  .bar h1 {
    margin: 0;
    font:
      700 1.2rem/1.2 Georgia,
      serif;
  }
  .close {
    color: #fff;
    text-decoration: none;
    font-size: 1.8rem;
    line-height: 1;
    padding: 0 0.3rem;
  }
  .close.labelled {
    font-size: 0.95rem;
    border: 1px solid #fff;
    border-radius: 1rem;
    padding: 0.25rem 0.75rem;
  }
  /* The parent overlay draws its own X when embedded. */
  .embed .close {
    visibility: hidden;
  }
  #game-root {
    position: relative;
    flex: 1;
    min-height: 0;
    touch-action: none;
  }
  .notice {
    max-width: 28rem;
    margin: 15vh auto 0;
    padding: 1rem;
    text-align: center;
  }
</style>

<script>
  import { games } from '../chaos/registry';

  const root = document.getElementById('game-root')!;
  const slug = root.dataset.slug!;
  const embedded = new URLSearchParams(location.search).has('embed') && parent !== window;
  if (embedded) document.documentElement.classList.add('embed');

  // Embedded: ask the parent overlay to close. Standalone: follow the back link.
  function exit(): void {
    if (embedded) parent.postMessage({ type: 'chaos:close' }, location.origin);
    else location.href = document.querySelector<HTMLAnchorElement>('.close')!.href;
  }
  addEventListener('keydown', (e) => {
    if (e.key === 'Escape') exit();
  });

  const game = games[slug];
  const touchOnly = matchMedia('(hover: none) and (pointer: coarse)').matches;
  if (game && touchOnly && !game.touch) {
    root.append(
      document.querySelector<HTMLTemplateElement>('#desktop-only')!.content.cloneNode(true),
    );
  } else if (game) {
    game
      .load()
      .then((mod) => {
        const cleanup = mod.default(root);
        addEventListener('pagehide', () => cleanup(), { once: true });
      })
      .catch((err) => {
        console.error(err);
        root.textContent = 'This game failed to load. The porters have been informed.';
      });
  }
</script>
