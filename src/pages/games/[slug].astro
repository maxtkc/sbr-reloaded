---
import GameLayout from '../../layouts/GameLayout.astro';
import { games } from '../../chaos/registry';

export function getStaticPaths() {
  return Object.entries(games).map(([slug, game]) => ({
    params: { slug },
    props: { title: game.title, closeLabel: game.closeLabel },
  }));
}

const { slug } = Astro.params;
const { title, closeLabel } = Astro.props;
---

<GameLayout title={title} slug={slug} closeLabel={closeLabel} />
