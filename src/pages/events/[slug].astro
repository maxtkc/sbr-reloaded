---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubscribeButtons from '../../components/SubscribeButtons.astro';
import { occurrences, formatWhen, categoryLabels } from '../../lib/events';
import { googleEventLink, outlookEventLink } from '../../lib/calendar-links';
import { plainText } from '../../lib/ics';
import { url } from '../../lib/url';

export const getStaticPaths = (async () => {
  const events = await getCollection('events');
  return events.map((event) => ({ params: { slug: event.id }, props: { event } }));
}) satisfies GetStaticPaths;

interface Props {
  event: CollectionEntry<'events'>;
}
const { event } = Astro.props;
const { title, location, category, ticketUrl, price, tbc, rrule, allDay, image, imageAlt } =
  event.data;
const { Content } = await render(event);
const dates = occurrences(event);
const pageUrl = new URL(url(`/events/${event.id}`), Astro.site).href;
const google = googleEventLink(event, pageUrl);
const outlook = outlookEventLink(event, pageUrl);
const full = image && (await getImage({ src: image, width: Math.min(1600, image.width) })).src;
const description = plainText(event.body).slice(0, 160) || undefined;
const priceLabel = price === undefined ? undefined : price === 0 ? 'Free' : `£${price.toFixed(2)}`;
---

<BaseLayout title={title} description={description} image={image}>
  <main class="section">
    <article class="wrap">
      <p class="back">
        <a href={url('/events')}>&lt;- All events</a>
      </p>
      <p class="kicker">
        <span class="tag">{categoryLabels[category]}</span>
      </p>
      <h1>{title}</h1>
      {image && (
        <a class="flier" href={full} target="_blank" rel="noopener">
          <Image
            src={image}
            alt={imageAlt ?? `${title} flier`}
            width={400}
            densities={[1, 2]}
            loading="eager"
          />
        </a>
      )}
      <dl class="facts">
        <dt>When</dt>
        <dd>
          {rrule ? `${dates.length} dates, ${formatWhen(dates[0])} onwards` : formatWhen(dates[0])}
          {tbc && <span class="tbc">date to be confirmed</span>}
        </dd>
        <dt>Where</dt>
        <dd>{location}</dd>
        {priceLabel && (
          <>
            <dt>Price</dt>
            <dd>{priceLabel}</dd>
          </>
        )}
        {ticketUrl && (
          <>
            <dt>Tickets</dt>
            <dd>
              <a href={ticketUrl}>{ticketUrl.replace(/^https?:\/\//, '')}</a>
            </dd>
          </>
        )}
      </dl>
      <div class="prose">
        <Content />
      </div>

      <h2>Add to your calendar</h2>
      <div class="btn-row">
        <a class="btn" href={google} target="_blank" rel="noopener">
          Add to Google Calendar
        </a>
        {!rrule && (
          <a class="btn secondary" href={outlook} target="_blank" rel="noopener">
            Add to Outlook
          </a>
        )}
        <a class="btn secondary" href={url(`/events/${event.id}.ics`)} download={`${event.id}.ics`}>
          Download .ics{rrule ? ' (all dates)' : ''}
        </a>
      </div>
      {rrule && (
        <p class="note">
          For Outlook, Apple Calendar and others, download the .ics file to add every date at once.
        </p>
      )}

      {rrule && (
        <>
          <h2>Dates</h2>
          <ol class="dates">
            {dates.map((o) => (
              <li data-end={allDay ? `${o.end}T23:59` : o.end}>{formatWhen(o)}</li>
            ))}
          </ol>
        </>
      )}

      <h2>Every SBR event</h2>
      <p>Subscribe once and new events appear in your calendar automatically.</p>
      <SubscribeButtons />
    </article>
  </main>
</BaseLayout>

<script>
  import { londonNow } from '../../lib/london-now';

  // Greys out dates that have already ended.
  const now = londonNow();
  for (const li of document.querySelectorAll<HTMLLIElement>('.dates li[data-end]')) {
    li.classList.toggle('past', (li.dataset.end ?? '') < now);
  }
</script>

<style>
  .back {
    margin: 0 0 1rem;
  }
  .kicker {
    margin: 0;
  }
  h2 {
    clear: both;
  }
  h1 {
    margin: 0.3rem 0 1rem;
  }
  .flier {
    float: right;
    width: min(18rem, 40%);
    margin: 0 0 1rem 1.5rem;
  }
  .flier img {
    display: block;
    width: 100%;
    border-radius: var(--radius);
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.15);
  }
  @media (max-width: 36rem) {
    .flier {
      float: none;
      display: block;
      width: auto;
      max-width: 22rem;
      margin: 0 0 1.25rem;
    }
  }
  .facts {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.4rem 1.2rem;
    margin: 0 0 1.5rem;
  }
  .facts dt {
    font-weight: 600;
    color: var(--muted);
  }
  .facts dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .tbc {
    margin-left: 0.5rem;
    font-style: italic;
    color: var(--muted);
  }
  .note {
    color: var(--muted);
    font-size: 0.95rem;
  }
  .dates {
    columns: 3 14rem;
    padding-left: 1.4rem;
  }
  .dates li {
    break-inside: avoid;
  }
  .dates li.past {
    color: var(--muted);
    text-decoration: line-through;
  }
</style>
