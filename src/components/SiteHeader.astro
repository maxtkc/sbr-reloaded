---
import { url } from '../lib/url';

const links = [
  { href: '/events', label: 'Events' },
  { href: '/#committee', label: 'Committee' },
  { href: '/#facilities', label: 'Facilities' },
  { href: '/freshers', label: "Freshers' Guide" },
  { href: '/quick-links', label: 'Quick links' },
  { href: '/history', label: 'History' },
];
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={url('/')}>
      Samuel Butler Room
    </a>
    <nav aria-label="Main">
      <ul>
        {links.map((l) => (
          <li>
            <a href={url(l.href)}>{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--primary);
    color: #fff;
    border-bottom: 3px solid var(--accent);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.5rem;
  }
  .brand {
    font: 700 1.35rem var(--serif);
    color: #fff;
    text-decoration: none;
    white-space: nowrap;
  }
  ul {
    display: flex;
    gap: 1.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    color: #fff;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    white-space: nowrap;
  }
  nav a:hover {
    color: var(--accent-light);
  }
  @media (max-width: 860px) {
    .bar {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding-top: 0.4rem;
    }
    nav {
      overflow-x: auto;
      scrollbar-width: none;
      padding: 0.3rem 0 0.5rem;
    }
  }
</style>
