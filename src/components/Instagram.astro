---
import { getCollection } from 'astro:content';

// Embed URL for a /p/<id>/ or /reel/<id>/ post (the schema guarantees the shape).
const embedUrl = (url: string) => {
  const [, kind, id] = url.match(/\/(p|reel)\/([\w-]+)/)!;
  return `https://www.instagram.com/${kind}/${id}/embed`;
};

const posts = (await getCollection('instagram')).sort((a, b) => a.data.order - b.data.order);
---

<section class="section" id="instagram">
  <div class="wrap">
    <h2>Instagram</h2>
    <p class="lead">
      Event announcements, photos and the occasional sheep. Find us at @samuelsroom.
    </p>
    {posts.length > 0 && (
      <ul class="posts">
        {posts.map((p) => (
          <li class="card">
            <iframe
              src={embedUrl(p.data.url)}
              title={p.data.caption ?? 'Instagram post from @samuelsroom'}
              loading="lazy"
            />
            {p.data.caption && <p>{p.data.caption}</p>}
            <a href={p.data.url}>View on Instagram</a>
          </li>
        ))}
      </ul>
    )}
    <div class="btn-row">
      <a class="btn" href="https://www.instagram.com/samuelsroom">
        Follow @samuelsroom
      </a>
    </div>
  </div>
</section>

<style>
  .posts {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  }
  .posts li {
    padding: 0.75rem;
    font-size: 0.95rem;
  }
  .posts p {
    margin: 0.6rem 0 0.3rem;
  }
  iframe {
    display: block;
    width: 100%;
    height: 560px;
    border: 0;
    border-radius: calc(var(--radius) - 4px);
    background: #fff;
  }
</style>
