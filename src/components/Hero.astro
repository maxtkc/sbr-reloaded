---
import AnimatedArms from './AnimatedArms.astro';
import { url } from '../lib/url';
---

<section class="hero">
  <div class="wrap inner">
    <div class="logo" data-game="flappy-eagle">
      <AnimatedArms />
    </div>
    <div>
      <p class="kicker">St John's College, Cambridge</p>
      <h1>The Samuel Butler Room</h1>
      <p class="tagline">
        The postgraduate society of St John's. Common room, committee, and community since 1960.
      </p>
      <div class="btn-row">
        <a class="btn" href={url('/#events')}>
          Upcoming events
        </a>
        <a class="btn secondary" href={url('/freshers')}>
          Freshers' Guide
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background:
      radial-gradient(circle at 20% 30%, rgb(200 16 46 / 0.22), transparent 55%),
      linear-gradient(160deg, var(--primary) 0%, var(--primary-dark) 100%);
    color: #fff;
    padding: 3.5rem 0;
  }
  .inner {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 2.5rem;
    align-items: center;
  }
  .logo :global(svg) {
    width: clamp(150px, 24vw, 260px);
    height: auto;
    display: block;
    filter: drop-shadow(0 6px 16px rgb(0 0 0 / 0.35));
  }
  h1 {
    color: #fff;
    margin: 0.2rem 0 0.6rem;
  }
  .kicker {
    margin: 0;
    color: var(--accent-light);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.85rem;
  }
  .tagline {
    font-size: 1.2rem;
    color: #e8ecf4;
  }
  .btn {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .btn:hover {
    background: var(--accent-dark);
    border-color: var(--accent-dark);
    color: #fff;
  }
  .btn.secondary {
    background: transparent;
    color: #fff;
    border-color: #fff;
  }
  .btn.secondary:hover {
    background: #fff;
    color: var(--primary-dark);
  }
  @media (max-width: 700px) {
    .inner {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }
    .btn-row {
      justify-content: center;
    }
  }
</style>
