---
// Soleh-bot data for the assistant gag: validated joke file and avatar URL, as JSON for client code.
import { getEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import { z } from 'astro/zod';
import avatar from '../assets/faces/soleh-anderlini.cutout.png';

const lines = z.array(z.string()).min(1);
const schema = z.object({
  name: z.string(),
  greeting: lines,
  thinking: lines,
  nudges: lines,
  fallbacks: lines,
  facts: lines,
  intents: z
    .array(
      z.object({
        id: z.string(),
        keywords: z.array(z.string()).min(1),
        examples: lines,
        replies: lines,
      }),
    )
    .min(1),
});

const entry = await getEntry('jokes', 'assistant');
const data = entry ? schema.parse(entry.data) : null;
const img = data ? await getImage({ src: avatar, width: 128, format: 'webp' }) : null;
// Escape < so text cannot close the script tag.
const json =
  data && img ? JSON.stringify({ ...data, avatar: img.src }).replace(/</g, '\\u003c') : null;
---

{json && <script type="application/json" id="assistant-data" set:html={json} />}
