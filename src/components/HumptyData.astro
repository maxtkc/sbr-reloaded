---
// Copy for the Humpty Dumpty gag: validated joke file, as JSON for client code.
import { getEntry } from 'astro:content';
import { z } from 'astro/zod';

const lines = z.array(z.string()).min(1);
const schema = z.object({
  fall: lines,
  men: lines,
  horses: lines,
  finale: z.string(),
  facts: lines,
  porter: lines,
});

const entry = await getEntry('jokes', 'humpty');
const data = entry ? schema.parse(entry.data) : null;
// Escape < so text cannot close the script tag.
const json = data ? JSON.stringify(data).replace(/</g, '\\u003c') : null;
---

{json && <script type="application/json" id="humpty-data" set:html={json} />}
