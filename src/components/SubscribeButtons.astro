---
import { subscribeLinks } from '../lib/calendar-links';
import { url } from '../lib/url';

const icsUrl = new URL(url('/calendar.ics'), Astro.site).href;
const links = subscribeLinks(icsUrl);
---

<div class="btn-row">
  <a class="btn" href={links.webcal} data-captcha>
    Subscribe to the calendar
  </a>
  <a class="btn secondary" href={links.google} target="_blank" data-captcha rel="noopener">
    Subscribe in Google Calendar
  </a>
  <a class="btn secondary" href={links.outlook} target="_blank" data-captcha rel="noopener">
    Subscribe in Outlook
  </a>
  <a class="btn secondary" href={url('/calendar.ics')} download="sbr.ics" data-captcha>
    Download .ics
  </a>
  <a
    class="btn secondary"
    href="https://github.com/maxtkc/sbr-reloaded/issues/new?template=event.yml"
    target="_blank"
    rel="noopener"
  >
    Suggest an event
  </a>
</div>
